#!/usr/bin/env bash
# Run an argus command on the Pi exactly as the services do: user argus, /var/lib/argus,
# and the credentials in /etc/argus/credentials. Installed to /usr/local/bin by install.sh.
# Examples: sudo argus-admin check-config · sudo argus-admin notify-test · sudo argus-admin sync --force
set -euo pipefail
[[ $EUID -eq 0 ]] || exec sudo "$0" "$@"
props=(-p User=argus -p Group=argus -p WorkingDirectory=/var/lib/argus -p Environment=PYTHONUNBUFFERED=1)
for f in /etc/argus/credentials/*; do
  [[ -f $f ]] && props+=(-p "LoadCredential=argus_$(basename "$f"):$f")
done
exec systemd-run --quiet --pipe --wait --collect "${props[@]}" /opt/argus/.venv/bin/argus "$@"
