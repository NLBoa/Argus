# Argus secrets. Copy to .env (git-ignored) for local dev; on the Pi use systemd
# credentials instead (deploy/install.sh). Leave a value empty to disable that feature.
# Never put real values in this file.

# Canvas tier 1: ELMS -> Calendar -> Calendar Feed (the URL itself is the secret)
ARGUS_CANVAS_ICAL_URL=
# Canvas tier 2: ELMS -> Account -> Settings -> New Access Token (only if UMD allows it)
ARGUS_CANVAS_TOKEN=

ARGUS_GRADESCOPE_EMAIL=
ARGUS_GRADESCOPE_PASSWORD=

ARGUS_PIAZZA_EMAIL=
ARGUS_PIAZZA_PASSWORD=
# Piazza fallback via Gmail API: path to the OAuth token JSON (outside the repo)
ARGUS_GMAIL_TOKEN_PATH=

ARGUS_TWILIO_ACCOUNT_SID=
ARGUS_TWILIO_AUTH_TOKEN=
ARGUS_TWILIO_FROM_NUMBER=
# The only number allowed to receive texts and send commands (E.164, e.g. +1...)
ARGUS_USER_PHONE_NUMBER=

# ntfy topic name: treat as a password (anyone who knows it can read your pushes)
ARGUS_NTFY_TOPIC=

ARGUS_ANTHROPIC_API_KEY=

# Dead-man's switch ping URL (e.g. healthchecks.io)
ARGUS_HEALTHCHECKS_URL=
